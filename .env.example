# ============================================================
# PROJECT AVI — Environment Configuration Template
# ============================================================

# --- 1. Neo4j Knowledge Graph Memory ---
LOCAL_NEO4J_URI=bolt://127.0.0.1:7687
LOCAL_NEO4J_USER=neo4j
LOCAL_NEO4J_PASSWORD=your_neo4j_password

# --- 2. Cloud Neo4j AuraDB (Optional Mirror) ---
AURA_NEO4J_URI=
AURA_NEO4J_USER=neo4j
AURA_NEO4J_PASSWORD=

# --- 3. FTMO MetaTrader 5 Bridge ---
# docker compose expands $VAR inside .env values: wrap any value containing $ in single quotes,
# e.g. FTMO_MT5_PASSWORD='pa$$word', or it will be silently truncated.
FTMO_MT5_LOGIN=your_login_here
FTMO_MT5_PASSWORD=your_password_here
FTMO_MT5_SERVER=FTMO-Demo

# --- 4. Cross-Platform / Linux Docker Settings ---
MT5_BRIDGE_HOST=mt5-wine
MT5_BRIDGE_PORT=8001
REPORTS_DIR=/app/reports
TZ=Asia/Kolkata
