# ============================================================
# PROJECT AVI // 24/7 AUTONOMOUS CLOUD TRADING ENGINE
# Ubuntu / Debian Slim Linux Container (Python 3.12)
# Cross-Platform Architecture with mt5linux / RPyC Bridge
# ============================================================

FROM python:3.12-slim

# Prevent Python from writing .pyc files and enable unbuffered terminal streaming
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app:/app/tier2_cortex:/app/tier3_evolution:/app/tier1_interface:/app/config" \
    REPORTS_DIR="/app/reports" \
    PORT=8888

# Install essential system build dependencies and network tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    netcat-openbsd \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python runtime packages (pinned for stability and Numba/NumPy compatibility)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    neo4j==6.1.0 \
    pandas==2.2.3 \
    numpy==2.0.2 \
    numba==0.60.0 \
    mt5linux==0.1.9 \
    rpyc \
    requests \
    urllib3 \
    websockets \
    python-dotenv

# Copy application files
COPY . /app

# Create persistent report and dossier directories
RUN mkdir -p /app/reports /app/November

# Make entrypoint executable
RUN chmod +x /app/entrypoint.sh

EXPOSE 8888

ENTRYPOINT ["/app/entrypoint.sh"]
